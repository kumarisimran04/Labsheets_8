// Program 13: Demonstrate single inheritance
#include <iostream>
#include <string>
using namespace std;

// Base class
class Person
{
protected:
    string name;
    int age;

public:
    // Function to input person details
    void input()
    {
        cout << "Enter name: ";
        getline(cin >> ws, name);

        cout << "Enter age: ";
        cin >> age;
    }

    // Function to display person details
    void display()
    {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
    }
};

// Student inherits from Person
class Student : public Person
{
private:
    float marks;

public:
    // Function to input student details
    void inputStudent()
    {
        input();

        cout << "Enter marks: ";
        cin >> marks;
    }

    // Function to display student details
    void displayStudent()
    {
        display();
        cout << "Marks: " << marks << endl;
    }
};

int main()
{
    // Create Student object
    Student s;

    // Input and display details
    s.inputStudent();

    cout << "\nStudent Details:\n";
    s.displayStudent();

    return 0;
}
