// Program 3: Sort an array using bubble sort
#include <iostream>
using namespace std;

// Function to sort the array
void sort(int a[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            // Compare adjacent elements
            if (a[j] > a[j + 1])
            {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
}

int main()
{
    int a[100], n, i;

    // Input array size
    cout << "Enter array size: ";
    cin >> n;

    if (n < 1 || n > 100)
    {
        cout << "Invalid array size.";
        return 0;
    }

    // Input array elements
    cout << "Enter array elements: ";
    for (i = 0; i < n; i++)
        cin >> a[i];

    // Sort the array
    sort(a, n);

    // Display sorted array
    cout << "Sorted array: ";
    for (i = 0; i < n; i++)
        cout << a[i] << " ";

    return 0;
}
