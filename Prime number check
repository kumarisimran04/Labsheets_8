// Program 1: Check whether a number is prime
#include <iostream>
using namespace std;

// Function to check prime number
int prime(int num)
{
    int i;

    if (num < 2)
        return 0;

    for (i = 2; i <= num / i; i++)
    {
        if (num % i == 0)
            return 0;
    }

    return 1;
}

int main()
{
    int num;

    // Input a number
    cout << "Enter a number: ";
    cin >> num;

    // Check and display the result
    if (prime(num) == 1)
        cout << num << " is a prime number.";
    else
        cout << num << " is not a prime number.";

    return 0;
}
