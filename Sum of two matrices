// Program 7: Find the sum of two matrices
#include <iostream>
using namespace std;

const int MAX = 10;

// Function to add two matrices
void add(int a[][MAX], int b[][MAX],
         int c[][MAX], int r, int col)
{
    int i, j;

    for (i = 0; i < r; i++)
    {
        for (j = 0; j < col; j++)
        {
            c[i][j] = a[i][j] + b[i][j];
        }
    }
}

int main()
{
    int a[MAX][MAX], b[MAX][MAX], c[MAX][MAX];
    int r, col, i, j;

    // Input matrix dimensions
    cout << "Enter rows and columns: ";
    cin >> r >> col;

    if (r < 1 || r > MAX || col < 1 || col > MAX)
    {
        cout << "Invalid matrix size.";
        return 0;
    }

    // Input first matrix
    cout << "Enter first matrix elements:\n";
    for (i = 0; i < r; i++)
        for (j = 0; j < col; j++)
            cin >> a[i][j];

    // Input second matrix
    cout << "Enter second matrix elements:\n";
    for (i = 0; i < r; i++)
        for (j = 0; j < col; j++)
            cin >> b[i][j];

    // Add the matrices
    add(a, b, c, r, col);

    // Display the result
    cout << "Sum of matrices:\n";
    for (i = 0; i < r; i++)
    {
        for (j = 0; j < col; j++)
            cout << c[i][j] << " ";

        cout << endl;
    }

    return 0;
}
