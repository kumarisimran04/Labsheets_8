// Program 5: Count words in a string
#include <iostream>
#include <string>
using namespace std;

// Function to count words
int count(string a)
{
    int i, n = 0, word = 0;

    for (i = 0; a[i] != '\0'; i++)
    {
        // A word starts at a non-space character
        if (a[i] != ' ' && a[i] != '\t' && a[i] != '\n')
        {
            if (word == 0)
            {
                n++;
                word = 1;
            }
        }
        else
        {
            word = 0;
        }
    }

    return n;
}

int main()
{
    string a;

    // Input a sentence
    cout << "Enter a sentence: ";
    getline(cin, a);

    // Display word count
    cout << "Number of words: " << count(a);

    return 0;
}
